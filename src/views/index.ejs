<%- include('partials/header') %>

<div class="container">
  <% const currentSelectedPriority = typeof selectedPriority !== 'undefined' ? selectedPriority : null; %>
  <div class="page-header">
    <h2>ToDo 一覧</h2>
    <div class="page-actions">
      <form action="/todos" method="GET" class="filter-form">
        <label for="priority">優先度</label>
        <select id="priority" name="priority" class="form-control form-control-inline">
          <option value="">すべて</option>
          <% priorities.forEach(p => { %>
            <option value="<%= p.value %>" <%= currentSelectedPriority === p.value ? 'selected' : '' %>>
              <%= p.label %>
            </option>
          <% }); %>
        </select>
        <button type="submit" class="btn btn-secondary">絞り込み</button>
        <% if (currentSelectedPriority !== null) { %>
          <a href="/todos" class="btn btn-secondary">解除</a>
        <% } %>
      </form>
      <a href="/todos/new" class="btn btn-primary">＋ 新規作成</a>
    </div>
  </div>

  <% if (todos.length === 0) { %>
    <% const selectedPriorityLabel = currentSelectedPriority !== null
      ? (priorities.find(p => p.value === currentSelectedPriority) || {}).label
      : null; %>
    <p class="empty-message">
      <%= currentSelectedPriority !== null
        ? `優先度「${selectedPriorityLabel}」に一致する ToDo はありません。`
        : 'ToDo がありません。新規作成してください。' %>
    </p>
  <% } else { %>
    <table class="todo-table">
      <thead>
        <tr>
          <th>優先度</th>
          <th>タイトル</th>
          <th>期限</th>
          <th>作成日時</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% todos.forEach(todo => { %>
          <tr class="priority-<%= todo.priority %>">
            <td class="priority-cell">
              <% const p = priorities.find(p => p.value === todo.priority); %>
              <span class="priority-badge priority-<%= todo.priority %>"><%= p ? p.label : '' %></span>
            </td>
            <td class="title-cell">
              <strong><%= todo.title %></strong>
              <% if (todo.content) { %>
                <p class="content-preview"><%= todo.content.length > 50 ? todo.content.substring(0, 50) + '…' : todo.content %></p>
              <% } %>
            </td>
            <td class="deadline-cell">
              <% if (todo.deadline) { %>
                <%= todo.deadline %>
              <% } else { %>
                <span class="no-value">-</span>
              <% } %>
            </td>
            <td class="date-cell"><%= todo.created_at %></td>
            <td class="actions-cell">
              <a href="/todos/<%= todo.id %>/edit" class="btn btn-secondary">編集</a>
              <form action="/todos/<%= todo.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('削除しますか？')">
                <button type="submit" class="btn btn-danger">削除</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('partials/footer') %>
