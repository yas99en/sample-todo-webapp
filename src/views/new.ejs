<%- include('partials/header') %>

<div class="container">
  <div class="page-header">
    <h2>ToDo 新規作成</h2>
    <a href="/todos" class="btn btn-secondary">← 一覧へ戻る</a>
  </div>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form action="/todos" method="POST" class="todo-form">
    <div class="form-group">
      <label for="title">タイトル <span class="required">*</span></label>
      <input type="text" id="title" name="title" class="form-control"
             value="<%= locals.values ? values.title : '' %>" required>
    </div>

    <div class="form-group">
      <label for="content">内容</label>
      <textarea id="content" name="content" class="form-control" rows="4"><%= locals.values ? values.content : '' %></textarea>
    </div>

    <div class="form-group">
      <label for="deadline">期限</label>
      <input type="date" id="deadline" name="deadline" class="form-control"
             value="<%= locals.values ? values.deadline : '' %>">
    </div>

    <div class="form-group">
      <label for="priority">優先度</label>
      <select id="priority" name="priority" class="form-control">
        <% priorities.forEach(p => { %>
          <option value="<%= p.value %>"
            <%= locals.values && parseInt(locals.values.priority) === p.value ? 'selected' : (p.value === 2 ? 'selected' : '') %>>
            <%= p.label %>
          </option>
        <% }); %>
      </select>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">作成</button>
      <a href="/todos" class="btn btn-secondary">キャンセル</a>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
